{
  "name": "dsh-rimielab-bot",
  "version": "0.2.0",
  "private": true,
  "description": "Keep you as the commit author while dsh-rimielab[bot] co-authors, with devlog and contributor metadata in sync",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.png"
  },
  "icon": "./icon.png",
  "files": [
    "lib",
    "templates",
    "locale",
    "icon.png",
    "cordis.patch.yml",
    "README.md"
  ],
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "git",
    "contributors"
  ],
  "license": "MIT",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
